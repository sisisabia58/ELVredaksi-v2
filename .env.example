DATABASE_URL=postgres://redaksi:redaksi@127.0.0.1:5432/redaksi
# Required. Must not be a value from the repo.
CRON_SECRET=
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_INPUT_USD_PER_MTOK=0.15
OPENAI_OUTPUT_USD_PER_MTOK=0.60
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional. Unset uses the code default of 10 requests/minute, under the
# free-tier minute window for gemini-3.5-flash-lite. A per-day 429 pauses
# every Gemini job until Google's retryDelay, whatever GEMINI_MAX_RPM is.
# GEMINI_MAX_RPM=10
GEMINI_INPUT_USD_PER_MTOK=0.30
GEMINI_OUTPUT_USD_PER_MTOK=2.50
# fake locks Mode latihan on, even if Pengaturan turns it off.
# Unset or meta allows a real post only after an admin turns Mode latihan off.
META_PROVIDER=fake
PUBLIC_BASE_URL=http://127.0.0.1:43123
# Optional. Encrypts the Instagram access token at rest. If empty, CRON_SECRET is used.
# If both are empty, the token is stored in plaintext and a warning is logged.
TOKEN_ENCRYPTION_KEY=
CONTACT_WA=
SEED_DEMO=

# v2: crawler (fake = no network) and cover images (demo = local fake).
CRAWLER_PROVIDER=fake
TAVILY_API_KEY=
# Optional. Unset = 5 articles per crawl source per scan.
# CRAWL_MAX_ARTICLES_PER_SCAN=5
IMAGE_PROVIDER=demo
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Cost recorded per AI cover. Unset = 0. Set from Cloudflare's current pricing.
CLOUDFLARE_IMAGE_USD_PER_IMAGE=
# Optional. Unset = 10 AI covers per WIB day, 0 = AI covers off.
# MAX_AI_COVERS_PER_DAY=10
